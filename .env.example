# Application environment
APP_ENV=development
DEBUG=false

POSTGRES_USER=taskhub
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=taskhub
POSTGRES_TEST_DB=taskhub_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DB_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Replace this placeholder before running the application or tests.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
